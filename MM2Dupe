--[[
    InventoryResetUI.lua (LocalScript)

    Advanced inventory reset UI:
    - Draggable top bar with title + minimize toggle
    - Header card: player avatar thumbnail, username, account age, device
    - Rarity dropdown with color swatches + counts, animated open/close
    - Scrolling item list with rarity-colored cards
    - Selected item summary card
    - Reset button with animated progress bar fill over a random 5-10s delay
    - On reset complete: +1 to the reset weapon's count, with a floating
      "+1" indicator and a toast notification
    - Subtle ambient glow pulse on the window border
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
