local function spawnFloatingPlusOne(anchorLabel)
    if not anchorLabel or not anchorLabel.Parent then return end

    local plusLabel = Instance.new("TextLabel")
    plusLabel.Size = UDim2.fromOffset(30, 16)
    plusLabel.Position = anchorLabel.Position - UDim2.fromOffset(0, 2)
    plusLabel.BackgroundTransparency = 1
    plusLabel.Text = "+1"
    plusLabel.TextColor3 = Color3.fromRGB(120, 255, 140)
    plusLabel.Font = Enum.Font.GothamBold
    plusLabel.TextSize = 13
    plusLabel.ZIndex = anchorLabel.ZIndex + 5
    plusLabel.Parent = anchorLabel.Parent

    tween(
        plusLabel,
        { Position = plusLabel.Position - UDim2.fromOffset(0, 16), TextTransparency = 1 },
        0.6,
        Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    task.delay(0.6, function()
        plusLabel:Destroy()
    end)
end

-- ============================================================
-- DRAGGING (top bar is the handle)
-- ============================================================

do
    local dragging = false
    local dragInput
    local dragStart
    local startPos

    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
end

