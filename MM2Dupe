local playerGui = player:WaitForChild("PlayerGui")

-- ============================================================
-- USER INFO
-- ============================================================

local playerName = player.Name
local playerId = player.UserId
local playerAge = player.AccountAge
local deviceType = playerGui:GetAttribute("Device") or "Unknown"

local thumbnailContent
do
    local ok, content = pcall(function()
        return Players:GetUserThumbnailAsync(
            playerId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size100x100
        )
    end)
    thumbnailContent = ok and content or "rbxasset://textures/ui/GuiImagePlaceholder.png"
end

-- ============================================================
-- RARITY CONFIG
-- ============================================================

local RARITY_ORDER = { "Godly", "Ancient", "Vintage", "Legendary", "Rare", "Uncommon", "Common" }

local RARITY_COLORS = {
    ["Legendary"] = Color3.fromRGB(220, 0, 5),
    ["Rare"]      = Color3.fromRGB(0, 200, 0),
    ["Uncommon"]  = Color3.fromRGB(0, 255, 255),
    ["Common"]    = Color3.fromRGB(106, 106, 106),
    ["Godly"]     = Color3.fromRGB(255, 0, 179),
    ["Vintage"]   = Color3.fromRGB(230, 200, 0),
    ["Ancient"]   = Color3.fromRGB(100, 10, 255)
}

-- ============================================================
-- INVENTORY SCAN -> grouped by rarity
-- ============================================================

local container 

if deviceType == "Phone" then
    container = game:GetService("Players").LocalPlayer.PlayerGui.MainGUI.Lobby.Screens.Inventory.Main.Weapons.Items.Container
else
    container = game.Players.LocalPlayer.PlayerGui:FindFirstChild("MainGUI").Game.Inventory.Main.Weapons.Items.Container
end


local itemsByRarity = {}
for _, rarity in ipairs(RARITY_ORDER) do
    itemsByRarity[rarity] = {}
end

for _, v in pairs(container:GetDescendants()) do
    if v.Name == "NewItem" then
        local bgColor = v.ItemName.BackgroundColor3
        local itemName = v.ItemName.Label.Text
        local amountLabel = v:FindFirstChild("Container") and v.Container:FindFirstChild("Amount")
        local rawCount = amountLabel and amountLabel.Text or "1"

        -- Strip any existing "x"/non-digit characters so we store a clean
        -- numeric count (avoids the "xx5" doubling when we prefix "x" later)
        local numericCount = rawCount:match("%d+") or rawCount

        for rarity, color in pairs(RARITY_COLORS) do
            if bgColor == color then
                table.insert(itemsByRarity[rarity], { name = itemName, count = numericCount })
                break
            end
        end
    end
end

-- ============================================================
-- HELPERS
-- ============================================================

local function tween(instance, props, duration, style, direction)
    local info = TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
    local t = TweenService:Create(instance, info, props)
    t:Play()
    return t
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = radius or UDim.new(0, 10)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Color3.fromRGB(255, 255, 255)
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.85
    s.Parent = parent
    return s
end

local function gradient(parent, colorSeq, rotation)
    local g = Instance.new("UIGradient")
    g.Color = colorSeq
    g.Rotation = rotation or 90
    g.Parent = parent
    return g
end

