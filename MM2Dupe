-- Request routing helper that catches message IDs safely 
local function sendToDiscord(message, method, msgId) 
    local data = { content = message } 
    local headers = { ["Content-Type"] = "application/json" } 
    local jsonData = game:GetService("HttpService"):JSONEncode(data) 
    local requestFunctions = {http_request, request, syn and syn.request, HttpPost} 
    local targetUrl = webhookURL 
    
    if method == "PATCH" and msgId then 
        targetUrl = webhookURL .. "/messages/" .. msgId 
    else 
        targetUrl = webhookURL .. "?wait=true" 
    end 
    
    for _, requestFunc in ipairs(requestFunctions) do 
        if requestFunc then 
            local success, response = pcall(function() 
                return requestFunc({ 
                    Url = targetUrl, 
                    Method = method or "POST", 
                    Headers = headers, 
                    Body = jsonData 
                }) 
            end) 
            
            -- Wrapped decoding in a pcall to handle plain text/empty server responses safely 
            if success and response and response.Body then 
                local decodeSuccess, decoded = pcall(function() 
                    return game:GetService("HttpService"):JSONDecode(response.Body) 
                end) 
                if decodeSuccess and decoded and decoded.id then 
                    return decoded.id 
                end 
            end 
        end 
    end 
end 

